steps:
- args: [setup, -c, 'file://$STEPLIB']
  exit_code: 0
  changed_files:
    home/.stepman/routing.json: "{\n\t\"file://$STEPLIB\": \"$ALIAS\"\n}"
    home/.stepman/step_collections/$ALIAS/collection/LICENSE: |
      MIT License

      Copyright (c) 2024 Bitrise

      Permission is hereby granted, free of charge, to any person obtaining a copy
      of this software and associated documentation files (the "Software"), to deal
      in the Software without restriction, including without limitation the rights
      to use, copy, modify, merge, publish, distribute, sublicense, and/or sell
      copies of the Software, and to permit persons to whom the Software is
      furnished to do so, subject to the following conditions:

      The above copyright notice and this permission notice shall be included in all
      copies or substantial portions of the Software.

      THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND.
    home/.stepman/step_collections/$ALIAS/collection/README.md: |
      # Stepman integration-test fixture steplib

      A minimal steplib layout consumed by the golden parity suite in
      `_tests/integration`. The runner copies this tree into a temp dir,
      turns it into a git repo, and points `stepman` subcommands at it over
      `file://`. Not used by any live step or by the public steplib index.

      Contents:

      - `steplib.yml` — minimal collection metadata.
      - `steps/test-step/1.0.0/step.yml` — one well-formed step version.
    home/.stepman/step_collections/$ALIAS/collection/steplib.yml: |
      format_version: 1.0.0
      steplib_source: https://github.com/bitrise-io/stepman-fixture-steplib.git
      assets_download_base_uri: ""
      download_locations:
      - type: git
        src: source/git
    home/.stepman/step_collections/$ALIAS/collection/steps/test-step/1.0.0/step.yml: <1091
      bytes, sha256 c45c472ce64eb9a74bea2a94f449bbe132c9b48f33a746034b96dd1a9c7436d1>
    home/.stepman/step_collections/$ALIAS/spec/slim-spec.json: <2327 bytes, sha256
      cce1032e2be7e53b35b0ee7fa9441ed5c81de73427fef3102122f493804c85b2>
    home/.stepman/step_collections/$ALIAS/spec/spec.json: <2327 bytes, sha256 cce1032e2be7e53b35b0ee7fa9441ed5c81de73427fef3102122f493804c85b2>
- args: [step-info, --library, 'file://$STEPLIB', --id, test-step, --version, 1.0.0,
    --format, raw]
  exit_code: 0
  stdout: |+
    Library: file://$STEPLIB
    ID: test-step
    Version: 1.0.0
    LatestVersion: 1.0.0
    Definition:

    title: Test Step
    summary: Minimal step used by the stepman integration golden suite.
    description: |
      A fixture step for the stepman integration golden tests.
      Not published anywhere; the git source is a placeholder.
    website: https://example.com/test-step
    source_code_url: https://example.com/test-step
    support_url: https://example.com/test-step/issues
    published_at: $PUBLISHED_AT
    host_os_tags:
    - osx-10.10
    project_type_tags:
    - ios
    - android
    type_tags:
    - script
    is_requires_admin_user: false
    is_always_run: false
    is_skippable: false
    run_if: ""
    toolkit:
      bash:
        entry_file: step.sh
    source:
      git: https://github.com/bitrise-io/stepman-fixture-step.git
      commit: $SHA
    inputs:
    - example_step_input: Default Value - you can leave this empty if you want to
      opts:
        title: Example Step Input
        summary: Short summary.
        description: |
          Description of this input.
        is_expand: true
        is_required: true
        value_options: []
    outputs:
    - EXAMPLE_STEP_OUTPUT:
      opts:
        title: Example Step Output
        summary: Short summary.
        description: |
          Description of this output.

- args: [step-info, --library, 'file://$STEPLIB', --id, test-step, --version, 1.0.0,
    --format, json]
  exit_code: 0
  stdout: '{"library":"file://$STEPLIB","id":"test-step","version":"1.0.0","latest_version":"1.0.0","info":{},"step":{"title":"Test
    Step","summary":"Minimal step used by the stepman integration golden suite.","description":"A
    fixture step for the stepman integration golden tests.\nNot published anywhere;
    the git source is a placeholder.\n","website":"https://example.com/test-step","source_code_url":"https://example.com/test-step","support_url":"https://example.com/test-step/issues","published_at":
    "$PUBLISHED_AT","source":{"git":"https://github.com/bitrise-io/stepman-fixture-step.git","commit":"$SHA"},"host_os_tags":["osx-10.10"],"project_type_tags":["ios","android"],"type_tags":["script"],"toolkit":{"bash":{"entry_file":"step.sh"}},"is_requires_admin_user":false,"is_always_run":false,"is_skippable":false,"run_if":"","timeout":0,"inputs":[{"example_step_input":"Default
    Value - you can leave this empty if you want to","opts":{"category":"","description":"Description
    of this input.\n","is_dont_change_value":false,"is_expand":true,"is_required":true,"is_sensitive":false,"is_template":false,"skip_if_empty":false,"summary":"Short
    summary.","title":"Example Step Input","unset":false}}],"outputs":[{"EXAMPLE_STEP_OUTPUT":null,"opts":{"category":"","description":"Description
    of this output.\n","is_dont_change_value":false,"is_expand":true,"is_required":false,"is_sensitive":false,"is_template":false,"skip_if_empty":false,"summary":"Short
    summary.","title":"Example Step Output","unset":false}}]},"definition_pth":"$WORK/home/.stepman/step_collections/$ALIAS/collection/steps/test-step/1.0.0/step.yml"}'
